# Réglages non secrets des tests Jenkins (ecc-devops, étape tests). Les secrets sont des fichiers montés dans l'agent
# (ecc-devops/scripts/Initialize-TestRuntime.ps1), lus par FileAwareEnv : VARIABLE_FILE l'emporte sur VARIABLE.
SECRET_KEY_FILE=/run/secrets/ci/django-secret-key
DATABASE_URL_FILE=/run/secrets/ci/digecc-database-url
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Porto-Novo
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_URL=http://localhost
